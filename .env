# ==========================================
# Placement Portal Configuration Environment
# ==========================================

# ----------------------------
# System Environment Mode
# ----------------------------
NODE_ENV=production
PORT=5000

# ----------------------------
# Database Settings (MongoDB)
# ----------------------------
# Internal database port. Keep default.
MONGO_PORT=27017

# Root credentials for initial database setup
MONGO_INITDB_ROOT_USERNAME=db_admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_DATABASE=placement_portal

# Backend connection string (referencing the database service name 'placement-db')
MONGODB_URI=mongodb://db_admin:admin@placement-db:27017/placement_portal?authSource=admin

# ----------------------------
# Security & JWT Tokens
# ----------------------------
# Replace these keys with strong, random strings (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET=jd6Hrad5rLriygtzDsyvUoMXTU4Rmyv1vLbrN1MLVvj
JWT_REFRESH_SECRET=jd6Hrad5rLriygtzDsyvUoMXTU4Rmyv1vLbrN1MLVvj

# ----------------------------
# CORS & Ingress Routing
# ----------------------------
# The base URL where your client accesses the frontend (for CORS verification)
CLIENT_URL=http://localhost
# If running on a custom port, include it (e.g. http://localhost:8080)
# CLIENT_URL=http://localhost:8080

# ----------------------------
# Frontend Server Port Binding
# ----------------------------
# The port on the host machine mapping to the frontend Nginx server (port 80 inside container)
FRONTEND_HOST_PORT=80
